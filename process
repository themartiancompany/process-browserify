function
  _global_get() {
  let
    _global;
  if ( typeof window === 'undefined' &&
       ( typeof global !== 'undefined' && global.global === global ) &&
       typeof __webpack_require__ !== 'function' ) {
    _global =
      global;
  }
  if ( typeof(
         window) != "undefined" ) {
    _global =
      window;
  }
  return _global;
}

function
  _fs_module_get() {
  let
    _module_found,
    _module_name;
  const
    _fs_module_names = [
      "_fs",
      "_fs_module",
      "fs",
      "fs_module"
    ];
  const
    _global =
      _global_get();
  _module_found =
    false;
  for ( _module_name of _fs_module_names ) {
    if ( _module_name in _global ) {
      _fs_module =
        _global[
          _module_name];
      _module_found =
        true;
      break;
    }
  }
  if ( ! _module_found ) {
    _fs_module =
      require(
        "tmcfs");
  }
  return _fs_module;
}

function
  _browser_process_module_get(
    _fs_module) {
  if ( typeof(
         _fs_module) == "undefined" ||
       _fs_module == "" ) {
    _fs_module =
      _fs_module_get();
  }
  const
    _process =
      {};
  _process[
    "argv"] =
      _argv;
  _process[
    "chdir"] =
      _chdir;
  _process[
    "cwd"] =
      _cwd;
  _process[
    "exit"] =
      _exit;
  return _process;
}

function
  _process_module_auto_detect(
    _fs_module) {
  let
    _process;
  if ( _fs_module == "" ||
       typeof(
         _fs_module) === 'undefined' ) {
    _fs_module =
      _fs_module_get();
  }
  if ( typeof window === 'undefined' &&
       ( typeof global !== 'undefined' && global.global === global ) &&
       typeof __webpack_require__ !== 'function' ) {
    _process =
      require(
        "node:process");
    _process[
      "browser"] =
      false;
  }
  else {
    _process =
      _browser_process_module_get(
        _fs_module);
  }
  return _process;
}

function
  _process_module_get(
    _module_name) {
  //   _fs_module) {
  let
    _process;
  _fs_module =
    _fs_module_get();
  if ( _module_name == "" ||
       typeof(
         _module_name) === 'undefined' ) {
    _process =
      _process_module_auto_detect(
        _fs_module);
  }
  else if ( _module_name == 'process-browserify' ) {
    _process =
      _browser_process_module_get(
        _fs_module);
  }
  else if ( _module_name == 'node:process' ) {
    _process =
      require(
        _module_name);
    _process[
      "browser"] =
      false;
  }
  else if ( _module_name == 'process' ) {
    _process =
      _process_module_auto_detect(
        _fs_module);
  }
  else {
    const
      _msg =
        "Unknown process module " +
        `'${_module_name}'.`.
    const
      _error =
      { "msg":
          _msg };
    console.error(
      _msg);
    throw _error
  }
  return _process;
}

function
  _argv(
    _key_name) {
  let
    _assignment,
    _assignments,
    _key,
    _key_value,
    _location,
    _msg,
    _result,
    _url,
    _value;
  if ( typeof(
         _key_name) === 'undefined' ||
       _key_name == "" ||
       _key_name == null ) {
    _msg =
      "Getting all values.";
    _msg_info(
      _msg);
    _key_name =
      "";
  }
  const
    _return =
      [];
  _location =
    window.location;
  _url =
    _location.search.substring(
      1);
  _assignments =
    _url.split(
      '&');
  for ( _result =
          0;
        _result <
          _assignments.length;
        _result++ ) {
    _assignment =
      _assignments[
        _result];
    _key_value =
      _assignment.split(
        '=');
    _key =
      _key_value[
        0];
    if ( _key.length < 2 ) {
      _return.push(
        `-${_key}`);
    }
    else {
      _return.push(
        `--${_key}`);
    }
    if ( _key == _key_name ||
         _key_name == "" ) {
      _value =
        _key_value[
          1];
      _return.push(
        _value);
    }
  }
  return _return;
}

function
  _cwd(
    _fs_module) {
  if ( typeof(
         _fs_module) == "undefined" ||
       _fs_module == "" ) {
    _fs_module =
      _fs_module_get();
  }
  return _fs_module.CURRENT_DIR;
}

function
  _chdir(
    _dir,
    _fs_module) {
  let
    _return;
  if ( typeof(
         _fs_module) == "undefined" ||
       _fs_module == "" ) {
    _fs_module =
      _fs_module_get();
  }
  const
    _dir_exists =
      _fs_module.isDir;
  if ( _dir_exists(
         _dir) ) {
    _fs_module.CURRENT_DIR =
      _dir;
    _return =
      true;
  }
  else {
    _return =
      false;
    const
      _msg =
        `Directory '${_dir}' ` +
        "does not exist.";
    _msg_error(
      _msg,
      0);
  }
  return _return;
}

function
  _exit(
    _code) {
  return _code;
};

_fs_module =
  _fs_module_get();

const
  _process =
    _process_module_auto_detect(
      _fs_module);

module.exports =
  _process;
module.exports.getModule =
  _process_module_get;
